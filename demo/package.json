{
  "name": "harbour-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Small end-to-end demo built with the game-builder skill",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174",
    "build": "vite build",
    "verify:assets": "python3 ../game-builder/scripts/glb_audit.py public/assets --recursive --budget preset:hero --loop-check --json shots/asset-audit.json",
    "search": "node --env-file-if-exists=.env.local server/exa-search.js"
  },
  "dependencies": {
    "exa-js": "2.28.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "vite": "^8.3.8"
  }
}
